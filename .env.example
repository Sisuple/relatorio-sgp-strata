# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=database_name
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=
CACHE_DEFAULT_TTL=1800

# Application Settings
APP_NAME=Streamlit MySQL App
APP_DEBUG=False

# Google Maps — chave com a "Maps Embed API" habilitada (Street View ao clicar no mapa)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# IAGON — assistente de IA (opcional; sem a chave o assistente fica desabilitado)
API_OPENAI_KEY=your_openai_api_key

# auth-gateway — bloqueio de acesso direto ao dashboard (ver docs/dashboard-iframe-auth-deploy.md)
# Segredo compartilhado com o SGP para assinar o token curto do iframe.
# Precisa ser IGUAL ao configurado no SGP deste mesmo ambiente e DIFERENTE por ambiente (hom/DNIT-RO/CNL).
IFRAME_AUTH_SECRET=change-me-shared-with-sgp
# Segredo só deste servidor, usado para assinar o cookie de sessão de 2h. Gerar com: openssl rand -hex 32
GATEWAY_SESSION_SECRET=change-me-local-only
